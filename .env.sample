# Logging
CAO_LOGGING_LEVEL=INFO
CAO_LOGGING_FILE=logs/climate_action.log
CAO_LOGGING_MAX_SIZE=10485760  # 10MB
CAO_LOGGING_BACKUP_COUNT=5

# Application Settings
